{
  "schema": "ohho.sweep/v1",
  "seed": 1,
  "strategy": "random",
  "budget": {"max_trials": 32},
  "dimensions": [
    {
      "name": "lr",
      "path": "optimizer.lr",
      "type": "log_uniform",
      "low": 1e-5,
      "high": 1e-2
    }
  ],
  "objectives": [
    {"name": "val_loss", "direction": "minimize", "primary": true}
  ],
  "early_stopping": {
    "metric": "val_loss",
    "mode": "min",
    "rule": "asha",
    "rungs": [1, 3, 9, 27, 81],
    "reduction_factor": 3,
    "grace_period": 1
  }
}
