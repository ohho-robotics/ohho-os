{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohho-robotics.com/schemas/ohho.recipe/v1.json",
  "title": "ohho.recipe/v1",
  "description": "One description of a training run. Families are an open registry id. This build ships examples for act, diffusion, smolvla, openvla, and ppo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "dataset", "output"],
  "properties": {
    "schema": {
      "description": "Recipe document identifier.",
      "const": "ohho.recipe/v1"
    },
    "name": {
      "description": "Human-readable run name.",
      "type": "string"
    },
    "family": {
      "description": "Policy family id. Built-in ids: act, diffusion, smolvla, openvla, ppo. Plugins register more.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "base_weights": {
      "description": "Checkpoint the trainer should start from. Loading it is family-specific.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "dataset": {
      "description": "Local directory or a dataset version id. Set exactly one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": ["path"],
          "not": {"required": ["version_id"]}
        },
        {
          "required": ["version_id"],
          "not": {"required": ["path"]}
        }
      ]
    },
    "hyperparameters": {
      "description": "Family hyperparameters. Known keys are typed; other keys are left for plugins.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "train_steps": {"type": "integer", "minimum": 1},
        "num_epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "chunk_size": {"type": "integer", "minimum": 1},
        "d_model": {"type": "integer", "minimum": 1},
        "nhead": {"type": "integer", "minimum": 1},
        "num_encoder_layers": {"type": "integer", "minimum": 1},
        "num_decoder_layers": {"type": "integer", "minimum": 1},
        "dim_feedforward": {"type": "integer", "minimum": 1},
        "latent_dim": {"type": "integer", "minimum": 1},
        "kl_weight": {"type": "number", "minimum": 0},
        "log_every": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "horizon": {"type": "integer", "minimum": 1},
        "rollout_steps": {"type": "integer", "minimum": 1},
        "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "task": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "num_envs": {"type": "integer", "minimum": 1},
        "updates": {"type": "integer", "minimum": 1},
        "clip_coef": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "entropy_coef": {"type": "number", "minimum": 0},
        "gae_lambda": {"type": "number", "minimum": 0, "maximum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "episode_steps": {"type": "integer", "minimum": 1},
        "reward_weights": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "precision": {
      "description": "Numeric format for the training step. fp32 is the default and runs on every device. fp16 uses torch.amp autocast and GradScaler loss scaling on CUDA. bf16 uses torch.amp autocast where bfloat16 runs, including CPU when that autocast succeeds. fp8 uses Transformer Engine on a CUDA GPU with compute capability 8.9 or newer. An unsupported choice fails before training. There is no fallback to another precision.",
      "type": "string",
      "enum": ["fp32", "fp16", "bf16", "fp8"],
      "default": "fp32"
    },
    "device": {
      "type": "string",
      "enum": ["cpu", "cuda", "mps", "auto"],
      "default": "cpu"
    },
    "pruning": {
      "description": "Optional pruning. Omit it to train a dense model. target_sparsity, schedule, include, and exclude are sweepable with --set. nm_2_4 keeps 2 of every 4 weights, so its target_sparsity is 0.5. include and exclude are module-name patterns; an empty include selects every layer the method can prune, and exclude wins.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "schedule", "target_sparsity"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["unstructured", "structured_channel", "structured_head", "nm_2_4"]
        },
        "schedule": {
          "type": "string",
          "enum": ["one_shot", "gradual", "iterative"]
        },
        "target_sparsity": {
          "description": "Fraction of weights or channels or heads to remove. 0.5 for nm_2_4.",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "include": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "exclude": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "start_step": {
          "description": "First gradual step. Defaults to 0. Only for schedule gradual.",
          "type": "integer",
          "minimum": 0
        },
        "end_step": {
          "description": "Gradual step that reaches target_sparsity. Defaults to the last optimizer step. Only for schedule gradual.",
          "type": "integer",
          "minimum": 0
        },
        "iterations": {
          "description": "Prune-and-fine-tune cycles. Defaults to 3. Only for schedule iterative.",
          "type": "integer",
          "minimum": 1
        },
        "finetune_steps": {
          "description": "Optimizer steps after each iterative prune. When set, the run length is iterations times this value. Only for schedule iterative.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "qat": {
      "description": "Optional quantisation-aware training block. Absent means QAT does not run. bit_width (8 or 4), granularity (per_tensor or per_channel), calibration_steps, and finetune_steps are plain fields a sweep can set. scope is weight_only (default) or weight_and_activation. Weight-and-activation needs calibration_steps >= 1. symmetric defaults to true; activation_granularity and activation_symmetric default to the weight settings. export_onnx asks for a Q/DQ ONNX file. Family act cannot lower its transformer, so that flag is refused for act.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "bit_width": {"type": "integer", "enum": [8, 4], "default": 8},
        "scope": {
          "type": "string",
          "enum": ["weight_only", "weight_and_activation"],
          "default": "weight_only"
        },
        "granularity": {
          "type": "string",
          "enum": ["per_tensor", "per_channel"],
          "default": "per_channel"
        },
        "activation_granularity": {
          "type": "string",
          "enum": ["per_tensor", "per_channel"]
        },
        "symmetric": {"type": "boolean", "default": true},
        "activation_symmetric": {"type": "boolean"},
        "calibration_steps": {"type": "integer", "minimum": 0, "default": 0},
        "finetune_steps": {"type": "integer", "minimum": 0, "default": 0},
        "export_onnx": {"type": "boolean", "default": false}
      }
    },
    "compression_hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/hook"}
    },
    "eval_hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/hook"}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {
          "description": "Directory for the checkpoint, metrics, and run manifest.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "params": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
