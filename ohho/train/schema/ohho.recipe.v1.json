{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohho-robotics.com/schemas/ohho.recipe/v1.json",
  "title": "ohho.recipe/v1",
  "description": "One description of a training run. Families are an open registry id. This build ships examples for act, diffusion, smolvla, openvla, and ppo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "dataset", "output"],
  "properties": {
    "schema": {
      "description": "Recipe document identifier.",
      "const": "ohho.recipe/v1"
    },
    "name": {
      "description": "Human-readable run name.",
      "type": "string"
    },
    "family": {
      "description": "Policy family id. Built-in ids: act, diffusion, smolvla, openvla, ppo. Plugins register more.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "base_weights": {
      "description": "Checkpoint the trainer should start from. Loading it is family-specific.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "dataset": {
      "description": "Local directory or a dataset version id. Set exactly one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": ["path"],
          "not": {"required": ["version_id"]}
        },
        {
          "required": ["version_id"],
          "not": {"required": ["path"]}
        }
      ]
    },
    "hyperparameters": {
      "description": "Family hyperparameters. Known keys are typed; other keys are left for plugins.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "train_steps": {"type": "integer", "minimum": 1},
        "num_epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "chunk_size": {"type": "integer", "minimum": 1},
        "d_model": {"type": "integer", "minimum": 1},
        "nhead": {"type": "integer", "minimum": 1},
        "num_encoder_layers": {"type": "integer", "minimum": 1},
        "num_decoder_layers": {"type": "integer", "minimum": 1},
        "dim_feedforward": {"type": "integer", "minimum": 1},
        "latent_dim": {"type": "integer", "minimum": 1},
        "kl_weight": {"type": "number", "minimum": 0},
        "log_every": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "horizon": {"type": "integer", "minimum": 1},
        "rollout_steps": {"type": "integer", "minimum": 1},
        "gamma": {"type": "number", "minimum": 0, "maximum": 1},
        "task": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "num_envs": {"type": "integer", "minimum": 1},
        "updates": {"type": "integer", "minimum": 1},
        "clip_coef": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "entropy_coef": {"type": "number", "minimum": 0},
        "gae_lambda": {"type": "number", "minimum": 0, "maximum": 1},
        "hidden_size": {"type": "integer", "minimum": 1},
        "episode_steps": {"type": "integer", "minimum": 1},
        "reward_weights": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "precision": {
      "description": "Numeric format for the training step. fp32 is the default and runs on every device. fp16 uses torch.amp autocast and GradScaler loss scaling on CUDA. bf16 uses torch.amp autocast where bfloat16 runs, including CPU when that autocast succeeds. fp8 uses Transformer Engine on a CUDA GPU with compute capability 8.9 or newer. An unsupported choice fails before training. There is no fallback to another precision.",
      "type": "string",
      "enum": ["fp32", "fp16", "bf16", "fp8"],
      "default": "fp32"
    },
    "device": {
      "type": "string",
      "enum": ["cpu", "cuda", "mps", "auto"],
      "default": "cpu"
    },
    "qat": {
      "description": "Optional quantisation-aware training block. Absent means QAT does not run. bit_width (8 or 4), granularity (per_tensor or per_channel), calibration_steps, and finetune_steps are plain fields a sweep can set. scope is weight_only (default) or weight_and_activation. Weight-and-activation needs calibration_steps >= 1. symmetric defaults to true; activation_granularity and activation_symmetric default to the weight settings. export_onnx asks for a Q/DQ ONNX file. Family act cannot lower its transformer, so that flag is refused for act.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "bit_width": {"type": "integer", "enum": [8, 4], "default": 8},
        "scope": {
          "type": "string",
          "enum": ["weight_only", "weight_and_activation"],
          "default": "weight_only"
        },
        "granularity": {
          "type": "string",
          "enum": ["per_tensor", "per_channel"],
          "default": "per_channel"
        },
        "activation_granularity": {
          "type": "string",
          "enum": ["per_tensor", "per_channel"]
        },
        "symmetric": {"type": "boolean", "default": true},
        "activation_symmetric": {"type": "boolean"},
        "calibration_steps": {"type": "integer", "minimum": 0, "default": 0},
        "finetune_steps": {"type": "integer", "minimum": 0, "default": 0},
        "export_onnx": {"type": "boolean", "default": false}
      }
    },
    "compression_hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/hook"}
    },
    "eval_hooks": {
      "type": "array",
      "items": {"$ref": "#/$defs/hook"}
    },
    "distillation": {
      "description": "Optional knowledge distillation. The recipe family is the student imitation-learning recipe. The teacher is a registry model version or a local checkpoint. Absent means ordinary training.",
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher"],
      "properties": {
        "teacher": {"$ref": "#/$defs/teacher_ref"},
        "loss": {
          "description": "action_regression is mean squared error against teacher actions. kl is temperature-scaled KL on teacher outputs.",
          "type": "string",
          "enum": ["action_regression", "kl"],
          "default": "action_regression"
        },
        "feature_matching": {
          "description": "Add mean squared error between student and teacher features.",
          "type": "boolean",
          "default": false
        },
        "feature_weight": {
          "description": "Multiplier on the feature-matching term.",
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "mix_weight": {
          "description": "Weight on the teacher loss. The supervised imitation loss keeps 1 - mix_weight.",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "temperature": {
          "description": "Softmax temperature for KL on teacher outputs. Must be greater than 0. Action regression records it and does not apply it.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "cache_dir": {
          "description": "Directory for the teacher-output cache, shared across trials. The default is ~/.ohho/cache/teacher-outputs.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "properties": {
        "dir": {
          "description": "Directory for the checkpoint, metrics, and run manifest.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "params": {"type": "object", "additionalProperties": true}
      }
    },
    "teacher_ref": {
      "description": "A local checkpoint or a registry model version. Set exactly one.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint"],
          "not": {"required": ["registry"]},
          "properties": {
            "checkpoint": {
              "description": "Local tiny-teacher directory, or its policy.pt file.",
              "type": "string",
              "minLength": 1
            },
            "version": {
              "description": "Teacher version recorded in the student lineage and the output cache. When omitted, the version is sha256: plus the sha256 of policy.pt.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry"],
          "not": {"required": ["checkpoint"]},
          "properties": {
            "registry": {"$ref": "#/$defs/teacher_registry"}
          }
        }
      ]
    },
    "teacher_registry": {
      "description": "Registry model version. A ModelRegistry client resolves it to a local checkpoint. This build does not download weights.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "version"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
