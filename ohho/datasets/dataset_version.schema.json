{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohho-robotics.com/schemas/dataset_version.json",
  "title": "DatasetVersion",
  "description": "Immutable local dataset version (ohho.dataset_version.v1). One record maps to one future dataset_versions row. split and augmentation are included in content_hash. This file is not part of the transport protocol manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version_id",
    "dataset_name",
    "parent_version_id",
    "pinned",
    "content_hash",
    "source_query",
    "filters",
    "split",
    "seed",
    "augmentation",
    "stats",
    "licence",
    "storage_prefix",
    "created_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohho.dataset_version.v1"
    },
    "version_id": {
      "type": "string",
      "pattern": "^dv_[0-9a-f]{32}$"
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_version_id": {
      "type": ["string", "null"],
      "pattern": "^dv_[0-9a-f]{32}$"
    },
    "pinned": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots"],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_contains", "robot_type", "min_frames", "max_frames"],
      "properties": {
        "task_contains": {"type": ["string", "null"]},
        "robot_type": {"type": ["string", "null"]},
        "min_frames": {"type": ["integer", "null"], "minimum": 0},
        "max_frames": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "train", "val", "test", "strategy", "held_out_scenes"],
      "properties": {
        "name": {"type": "string", "enum": ["all", "train", "val", "test"]},
        "train": {"type": "number", "minimum": 0},
        "val": {"type": "number", "minimum": 0},
        "test": {"type": "number", "minimum": 0},
        "strategy": {
          "type": "string",
          "enum": ["episode", "session", "task", "scene"]
        },
        "held_out_scenes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "augmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_scale",
        "state_scale",
        "action_offset",
        "state_offset",
        "action_noise",
        "state_noise",
        "copies",
        "crop",
        "resize",
        "color_jitter",
        "blur",
        "temporal_stride",
        "cameras"
      ],
      "properties": {
        "action_scale": {"type": "number"},
        "state_scale": {"type": "number"},
        "action_offset": {"type": "number"},
        "state_offset": {"type": "number"},
        "action_noise": {"type": "number", "minimum": 0},
        "state_noise": {"type": "number", "minimum": 0},
        "copies": {"type": "integer", "minimum": 1},
        "crop": {"$ref": "#/$defs/optional_image_size"},
        "resize": {"$ref": "#/$defs/optional_image_size"},
        "color_jitter": {"$ref": "#/$defs/color_jitter"},
        "blur": {"type": "number", "minimum": 0},
        "temporal_stride": {"type": "integer", "minimum": 1},
        "cameras": {
          "type": "array",
          "items": {"$ref": "#/$defs/camera_toggle"}
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "frames", "action_ranges", "state_ranges"],
      "properties": {
        "episodes": {"type": "integer", "minimum": 0},
        "frames": {"type": "integer", "minimum": 0},
        "action_ranges": {
          "type": "array",
          "items": {"$ref": "#/$defs/axis_range"}
        },
        "state_ranges": {
          "type": "array",
          "items": {"$ref": "#/$defs/axis_range"}
        }
      }
    },
    "licence": {
      "type": "string",
      "maxLength": 512
    },
    "storage_prefix": {
      "type": "string",
      "pattern": "^versions/dv_[0-9a-f]{32}/dataset$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "axis_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "optional_image_size": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["height", "width"],
      "properties": {
        "height": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1}
      }
    },
    "color_jitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness", "contrast", "saturation", "hue"],
      "properties": {
        "brightness": {"type": "number", "minimum": 0},
        "contrast": {"type": "number", "minimum": 0},
        "saturation": {"type": "number", "minimum": 0},
        "hue": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "camera_toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"}
      }
    }
  }
}
