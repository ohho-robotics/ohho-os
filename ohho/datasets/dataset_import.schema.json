{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohho-robotics.com/schemas/dataset_import.json",
  "title": "DatasetImport",
  "description": "Pinned Hugging Face dataset import (ohho.dataset_import.v1). One file maps to one future dataset_imports row. revision and licence are immutable. This file is not part of the transport protocol manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repo_id",
    "revision",
    "requested_revision",
    "licence",
    "non_commercial",
    "revision_pinned",
    "licence_pinned",
    "version_id",
    "created_at"
  ],
  "properties": {
    "schema": {"type": "string", "const": "ohho.dataset_import.v1"},
    "repo_id": {"type": "string", "minLength": 1, "maxLength": 192},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requested_revision": {"type": ["string", "null"], "maxLength": 128},
    "licence": {"type": "string", "maxLength": 512},
    "non_commercial": {"type": "boolean"},
    "revision_pinned": {"type": "boolean", "const": true},
    "licence_pinned": {"type": "boolean", "const": true},
    "version_id": {"type": "string", "pattern": "^dv_[0-9a-f]{32}$"},
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
