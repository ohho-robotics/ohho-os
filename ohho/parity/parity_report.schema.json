{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohho-robotics.com/schemas/parity-report.v1.json",
  "title": "ParityReport",
  "description": "Numerical comparison of a reference model and an optimized artifact. result is pass or fail. The default fail is mean absolute difference above 0.05.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "reasons",
    "reference",
    "candidate",
    "target",
    "precision",
    "thresholds",
    "inputs",
    "outputs",
    "unchecked",
    "allow_parity_fail"
  ],
  "properties": {
    "schema": {"const": "ohho.parity/v1"},
    "result": {"enum": ["pass", "fail"]},
    "reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "family"],
      "properties": {
        "ref": {"type": "string"},
        "kind": {"type": "string"},
        "family": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "format": {"enum": ["onnx", "torchscript", "module", null]}
      }
    },
    "target": {"type": ["string", "null"]},
    "precision": {"type": ["string", "null"]},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_abs",
        "max_abs",
        "rmse",
        "cosine_min",
        "top1_min",
        "kl_max",
        "per_joint",
        "action_chunk"
      ],
      "properties": {
        "mean_abs": {"type": "number", "minimum": 0},
        "max_abs": {"type": ["number", "null"], "minimum": 0},
        "rmse": {"type": ["number", "null"], "minimum": 0},
        "cosine_min": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "top1_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "kl_max": {"type": ["number", "null"], "minimum": 0},
        "per_joint": {"type": ["number", "null"], "minimum": 0},
        "action_chunk": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "path",
        "seed",
        "n_requested",
        "n",
        "indices",
        "sha256",
        "dtype"
      ],
      "properties": {
        "source": {"enum": ["random", "dataset", "recorded"]},
        "path": {"type": ["string", "null"]},
        "seed": {"type": "integer"},
        "n_requested": {"type": "integer", "minimum": 1},
        "n": {"type": "integer", "minimum": 0},
        "indices": {
          "type": ["array", "null"],
          "items": {"type": "integer", "minimum": 0}
        },
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "dtype": {"const": "float32"}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "shape",
          "mean_abs",
          "max_abs",
          "rmse",
          "cosine",
          "per_joint",
          "action_chunk",
          "top1",
          "kl"
        ],
        "properties": {
          "name": {"type": "string"},
          "shape": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 1
          },
          "mean_abs": {"type": "number", "minimum": 0},
          "max_abs": {"type": "number", "minimum": 0},
          "rmse": {"type": "number", "minimum": 0},
          "cosine": {"type": "number", "minimum": -1, "maximum": 1},
          "per_joint": {
            "type": ["array", "null"],
            "items": {"type": "number", "minimum": 0}
          },
          "action_chunk": {"type": ["number", "null"], "minimum": 0},
          "top1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "kl": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "unchecked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "reason"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "allow_parity_fail": {"type": "boolean"}
  }
}
