# Keep the rules body and its golden files as LF so Windows checkouts
# (core.autocrlf) do not change the bytes the installer embeds.
ohho/agent_rules/*.md text eol=lf
ohho/bench/generated/* text eol=lf
ohho/bench/schemas/*.json text eol=lf
tests/fixtures/rules/** text eol=lf
scripts/ci/*.sh text eol=lf
.github/workflows/multiarch.yml text eol=lf
docs/ci-multiarch.md text eol=lf
